{
    "name": "destiny-ghost-api",
    "version": "2.22.5-The-Martlet",
    "description": "Node.js API for querying the Destiny database via SMS messages.",
    "main": "start.js",
    "type": "module",
    "scripts": {
        "coverage": "pnpm test:watch --coverage --run",
        "format": "remark . --quiet --frail --output",
        "lint": "biome check --write .",
        "lint:ci": "biome check .",
        "start:production": "NODE_ENV=production node --permission --allow-fs-read=./ --allow-fs-read=/agents/ --allow-fs-read=/var/tmp/ --allow-fs-write=./databases --allow-fs-write=/var/log/ --allow-fs-write=/var/tmp/ --allow-worker --allow-addons --allow-net --disable-proto=delete --disable-warning=SecurityWarning --disable-warning=ExperimentalWarning --import=./helpers/permission-model-patch.js -r dotenv/config --max-old-space-size=8192 --unhandled-rejections=strict start.js",
        "start:dev": "NODE_ENV=development pnpm start",
        "start": "node --disable-proto=delete -r dotenv/config --max-old-space-size=8192 --unhandled-rejections=strict start.js",
        "swagger": "rm -f openapi.json && swagger-jsdoc -d openapi.cjs ./**/*.routes.js -o openapi.json",
        "test": "pnpm test:watch --run",
        "test:watch": "NODE_ENV=test node -r dotenv/config node_modules/vitest/vitest.mjs",
        "prepare": "husky || true",
        "typecheck": "tsc --noEmit -p jsconfig.json"
    },
    "author": "Chris Paskvan",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/chrispaskvan/destiny-ghost-api"
    },
    "engines": {
        "node": ">=26.8.0 <27",
        "pnpm": ">=10.0.0"
    },
    "packageManager": "pnpm@10.33.0",
    "dependencies": {
        "@azure/cosmos": "^4.10.1",
        "@godaddy/terminus": "^4.12.1",
        "@google/genai": "^2.23.0",
        "@grpc/grpc-js": "^1.14.5",
        "@grpc/proto-loader": "^0.8.1",
        "@modelcontextprotocol/sdk": "^1.30.0",
        "@paralleldrive/cuid2": "^3.3.0",
        "@snyk/protect": "^1.1307.3",
        "applicationinsights": "^3.16.0",
        "awesome-phonenumber": "^7.8.0",
        "base64url": "^3.0.1",
        "bottleneck": "^2.19.5",
        "bullmq": "^6.3.8",
        "compression": "^1.8.2",
        "connect-redis": "^10.0.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "csrf-sync": "^4.2.1",
        "dotenv": "^18.0.1",
        "emoji-regex": "^11.0.0",
        "express": "^5.2.1",
        "express-session": "^1.19.0",
        "graphql": "^17.0.2",
        "graphql-http": "^1.23.0",
        "helmet": "^8.3.0",
        "html-to-text": "^10.0.1",
        "http-status-codes": "^2.3.0",
        "ioredis": "^6.0.0",
        "lru-cache": "^11.5.3",
        "nodemailer": "^10.0.10",
        "opossum": "^10.0.0",
        "p-limit": "^7.3.3",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "qs": "^6.16.0",
        "rate-limiter-flexible": "^11.2.1",
        "redis": "^6.2.1",
        "rfc6902": "^5.3.0",
        "swagger-ui-express": "^5.0.1",
        "tinypool": "^2.2.0",
        "twilio": "^6.1.1",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.14",
        "@types/cookie-parser": "^1.4.10",
        "@types/express": "^5.0.6",
        "@types/express-session": "^1.19.0",
        "@vitest/coverage-v8": "^5.0.1",
        "chance": "^1.1.13",
        "husky": "^9.1.7",
        "nock": "^14.0.17",
        "node-mocks-http": "^1.18.1",
        "pino-pretty": "^13.1.3",
        "remark-cli": "^12.0.1",
        "remark-lint-list-item-indent": "^4.0.1",
        "remark-preset-lint-consistent": "^6.0.1",
        "remark-preset-lint-recommended": "^7.0.1",
        "stream-json": "^3.6.0",
        "swagger-jsdoc": "^6.3.0",
        "typescript": "^7.0.2",
        "v8": "^0.1.0",
        "vitest": "^5.0.1"
    },
    "snyk": true,
    "pnpm": {
        "onlyBuiltDependencies": [
            "@google/genai",
            "msgpackr-extract",
            "protobufjs"
        ]
    }
}
